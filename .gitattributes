# Auto-detect text files and normalize line endings to LF
* text=auto eol=lf

# Explicitly set common file types
*.dart   text eol=lf
*.yaml   text eol=lf
*.yml    text eol=lf
*.json   text eol=lf
*.md     text eol=lf
*.txt    text eol=lf
*.cmake  text eol=lf
*.gradle text eol=lf
*.swift  text eol=lf
*.cc     text eol=lf
*.h      text eol=lf

# Binary files
*.png    binary
*.jpg    binary
*.jpeg   binary
*.gif    binary
*.ico    binary
*.jar    binary
*.zip    binary
